{
  "name": "lighttown-madness-league",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:server": "vite build --ssr src/server/main.ts --outDir dist-server",
    "server": "npm run build:server && node dist-server/main.js"
  },
  "dependencies": {
    "@dimforge/rapier3d": "^0.21.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "jsdom": "^30.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^5.0.3",
    "ws": "^8.22.0"
  }
}
